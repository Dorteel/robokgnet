@prefix fn: <https://w3id.org/robokgnet/framenet/1.7/> .
@prefix kg: <https://w3id.org/robokgnet/action/schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vn: <https://w3id.org/robokgnet/verbnet/2.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Agent> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Agent> kg:definition "The Agent is a sentient being who physically controls the movement of the Theme via the carrier, accompanying the Theme. 'Karl carried the books across the campus to the library.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Agent> kg:id "2117"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Agent> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Agent> rdfs:label "Agent" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Area> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Area> kg:definition "Area is used for descriprion of a general area in which the carrying action takes place when the motion is understood to be irregular or not to consist of a single, linear path." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Area> kg:id "2123"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Area> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Area> rdfs:label "Area" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Beneficiary> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Beneficiary> kg:definition "This FE describes the particpant for whom the bringing is beneficial. " .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Beneficiary> kg:id "10246"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Beneficiary> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Beneficiary> rdfs:label "Beneficiary" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Carrier> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Carrier> kg:definition "The Carrier provides support for the Theme.  Movement of the Carrier results in movement of the Theme. 'The boat ferried the troops across the river.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Carrier> kg:id "4863"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Carrier> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Carrier> rdfs:label "Carrier" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Co-participant> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Co-participant> kg:definition "Co_participant is an entity that participates in a coordinated way in the same event as the primary protagonist, regardless of whether the protagonist, and hence the Co-participant, is more agent- or more undergoer-like." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Co-participant> kg:id "10930"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Co-participant> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Co-participant> rdfs:label "Co-participant" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Constant_location> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Constant_location> kg:definition "The Constant_location expresses the location of the Theme relative to the Carrier.  This relationship holds for the entire length of the carrying event.  'Karl took the books to the library in his car.' 'Karl carried the books to the library in his arms.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Constant_location> kg:id "2122"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Constant_location> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Constant_location> rdfs:label "Constant_location" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Degree> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Degree> kg:definition "This frame element selects some gradable attribute and modifies the expected value for it." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Degree> kg:id "10929"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Degree> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Degree> rdfs:label "Degree" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Depictive> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Depictive> kg:definition "Depictive identifies a phrase describing the Carrier, Agent or Theme." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Depictive> kg:id "2125"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Depictive> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Depictive> rdfs:label "Depictive" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Distance> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Distance> kg:definition "This FE identifies the Distance the Theme is carried." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Distance> kg:id "2126"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Distance> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Distance> rdfs:label "Distance" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Duration> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Duration> kg:definition "Duration denotes the length of time from the beginning of a continuous situation (the one denoted by the target) to its end. In many cases, the continuous situation is a dynamic action which is ongoing, while in others it is simply an undifferentiated state." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Duration> kg:id "10931"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Duration> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Duration> rdfs:label "Duration" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Explanation> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Explanation> kg:definition "Explanation denotes a proposition from which the main clause (headed by the target) logically follows. This often means that the Explanation causes the target's proposition, but not in all cases. " .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Explanation> kg:id "10186"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Explanation> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Explanation> rdfs:label "Explanation" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Frequency> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Frequency> kg:definition "This frame element is used to indicate the location of a participant in cases where the multiple participants of an event are not co-located in the typical fashion. " .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Frequency> kg:id "10899"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Frequency> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Frequency> rdfs:label "Frequency" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Goal> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Goal> kg:definition "Goal identifies the endpoint of the path.    'Karl carried the books to the library.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Goal> kg:id "2118"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Goal> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Goal> rdfs:label "Goal" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Manner> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Manner> kg:definition "This FE identifies the Manner  in which the Carrier or Agent carries the Theme ." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Manner> kg:id "2127"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Manner> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Manner> rdfs:label "Manner" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Means> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Means> kg:definition "The actions the Agent takes to move the Theme. 'The books were taken to the library by helicopter deliveries.' 'I haul books by putting them on top of my head.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Means> kg:id "4866"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Means> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Means> rdfs:label "Means" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Particular_iteration> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Particular_iteration> kg:definition "Expressions marked with this extra-thematic FE modify a non-iterative use of the target, and indicate that it is conceived as embedded within an iterated series of similar events or states." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Particular_iteration> kg:id "10884"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Particular_iteration> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Particular_iteration> rdfs:label "Particular_iteration" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Path> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Path> kg:definition "Path along which carrying occurs. 'Karl carried the books across the campus.' " .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Path> kg:id "2120"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Path> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Path> rdfs:label "Path" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Period_of_iterations> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Period_of_iterations> kg:definition "This FE is minimally distinct from Duration and Duration_of final_state in that the clause described is conveyed to be iterative." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Period_of_iterations> kg:id "13038"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Period_of_iterations> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Period_of_iterations> rdfs:label "Period_of_iterations" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Place> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Place> kg:definition "The Place is the general area that serves as a setting for the specific motion of the Agent and Theme (with Source, Path, or Goal).   'Even in such a small port, these boats would transport many tons of trade-goods in to shore annually.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Place> kg:id "5453"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Place> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Place> rdfs:label "Place" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Purpose> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Purpose> kg:definition "The Purpose for which the Carrier or Agent carries the Theme . 'We had to carry the heavy weights all the way to the top of the hillto show our strength.'" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Purpose> kg:id "4850"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Purpose> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Purpose> rdfs:label "Purpose" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Source> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Source> kg:definition "Source indicates the beginning of the path along which the Theme travels.    'Karl hauled the books from the library  to the office.' " .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Source> kg:id "2119"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Source> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Source> rdfs:label "Source" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Speed> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Speed> kg:definition "The Speed is the rate at which the carrying or transporting occurs." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Speed> kg:id "4625"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Speed> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Speed> rdfs:label "Speed" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Theme> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Theme> kg:definition "The objects being carried. 'Karl toted the books to the car.' " .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Theme> kg:id "2121"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Theme> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Theme> rdfs:label "Theme" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Time> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Time> kg:definition "The time in which the carrying event takes place." .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Time> kg:id "5454"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Time> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Bringing/fe/Time> rdfs:label "Time" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Cognizer> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Cognizer> kg:definition "The Cognizer pays attention to an entity in order to discover something about it. The FE is normally expressed as an External Argument:  'Leslie examined the glass for cracks.'" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Cognizer> kg:id "128"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Cognizer> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Cognizer> rdfs:label "Cognizer" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Degree> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Degree> kg:definition "This FE identifies the Degree to which the Cognizer scrutinizes the Ground." .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Degree> kg:id "1500"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Degree> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Degree> rdfs:label "Degree" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Direction> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Direction> kg:definition "Direction is used for all path-like expressions, except those indicating the location of the perceiver, that describe how the perceiver's attention is directed during the act of perception.  'The detective looked across the street at the suspect.'" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Direction> kg:id "2335"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Direction> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Direction> rdfs:label "Direction" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Ground> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Ground> kg:definition "The Cognizer pays attention to the Ground, so named because it serves as the background or context for the Phenomenon. This FE can be expressed as an NP Object or as a PP Complement. 'Leslie examined the glass for cracks.' 'Kim searched the woods for mushrooms.'" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Ground> kg:id "129"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Ground> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Ground> rdfs:label "Ground" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Instrument> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Instrument> kg:definition "An entity directed by the Cognizer  that interacts with the Ground to accomplish the scrutiny.  'The temperature controller monitored the temperature with a calibrated silicon diode.'" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Instrument> kg:id "9143"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Instrument> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Instrument> rdfs:label "Instrument" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Manner> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Manner> kg:definition "This FE identifies the Manner in which the Cognizer scrutinizes the Ground." .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Manner> kg:id "1497"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Manner> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Manner> rdfs:label "Manner" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Means> kg:core_type "Peripheral" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Means> kg:definition "This FE is used for the Means by which the Cognizer to scrutinize the Ground. 'We analysed the sediment by putting it through the mass spec.'" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Means> kg:id "1498"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Means> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Means> rdfs:label "Means" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Medium> kg:core_type "Core" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Medium> kg:definition "The Medium is the piece of text or work in which the Cognizer pays attention to an entity in order to discover something about it. The FE is normally expressed as an External Argument:  'Chapter four examined the case for free speech.'" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Medium> kg:id "7030"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Medium> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Medium> rdfs:label "Medium" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Phenomenon> kg:core_type "Extra-Thematic" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Phenomenon> kg:definition "Phenomenon identifies the property that belongs to an entity or that the entity contains. Typically, it is expressed as a for-PP. 'Leslie examined the glass for cracks.' 'Kim searched the woods for mushrooms.' " .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Phenomenon> kg:id "130"^^xsd:integer .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Phenomenon> rdf:type kg:FrameElement .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Phenomenon> rdfs:label "Phenomenon" .
<https://w3id.org/robokgnet/framenet/1.7/Scrutiny/fe/Purpose> kg:core_type "Extra-Thematic" .
